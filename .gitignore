# Dart / Pub
.dart_tool/
.packages
build/
# Hinweis: pubspec.lock wird BEWUSST eingecheckt — Loam ist eine CLI/Executable
# (Dart-Konvention für Apps), nicht eine reine Library.

# Loam runtime artifacts
.loam/
baseline.json
# Default output of `loam scan --format html` — never commit a generated report.
loam-report.html

# Local scratch folder (issues live in internal forge; the folder is only kept ignored)
.scratch/

# Lokales Dev-Tooling (PROTECTED — niemals nach GitHub)
dev-tools/

# Local Claude Code state; project skills under .claude/skills are tracked.
/.claude/*
!/.claude/skills/
!/.claude/review.md

# Secrets / Tokens / Credentials (PROTECTED — niemals nach GitHub). Zusätzlich
# HART erzwungen durch den Content-Secret-Scan der internen Git-Hooks (pre-commit + pre-push).
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.token
*.secret
*credentials*.json
.netrc
id_rsa
id_ed25519

# OS / Editor
.DS_Store
*.iml
.idea/

# README/Docs-Attestierung (lokaler Push-Stempel)
.docs-attest
.readme-stamp

# Wrangler (Cloudflare) lokaler Cache
.wrangler/
