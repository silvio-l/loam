---
// Live, interactive preview of the actual `html` report loam.dev writes.
// The report at /demo-report is a real, self-contained artefact generated
// by `tool/gen-demo-report.sh` from a small demo project — not a screenshot.
// Embedded in an iframe so visitors can filter, select Findings and copy the
// fix-prompt right on the page.
//
// Linked/embedded via the extensionless /demo-report path, not /demo-report.html:
// Cloudflare Pages' Clean-URLs feature 308-redirects the .html path to this one,
// so a _headers rule keyed to /demo-report.html never actually applies to what
// the browser renders — it only ever sees the redirect response. That left the
// site-wide X-Frame-Options: DENY / frame-ancestors 'none' in force on the final
// document, which iframe-embeds it as a blank/black frame (seen in Safari).
// Pointing straight at /demo-report skips the redirect hop, so the frame-specific
// override in web/public/_headers (keyed to this same extensionless path) is what
// actually governs the response the iframe loads.
interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    heading: 'See a real report',
    body:
      "This is the exact <code>html</code> report loam.dev writes — rendered " +
      'from a small, deliberately messy demo project. It is live, not a ' +
      'screenshot: filter by rule or severity, pick the Findings you care ' +
      'about, and copy the assembled, versioned fix-prompt for your agent.',
    open: 'Open in new tab',
    label: 'Live demo',
    title: 'Interactive loam.dev demo report',
  },
  de: {
    heading: 'Sieh dir einen echten Report an',
    body:
      'Das ist exakt der <code>html</code>-Report, den loam.dev schreibt — ' +
      'erzeugt aus einem kleinen, bewusst unordentlichen Demo-Projekt. Live, ' +
      'kein Screenshot: nach Rule oder Severity filtern, die relevanten ' +
      'Findings auswählen und den fertigen, versionierten Fix-Prompt für ' +
      'deinen Agenten kopieren.',
    open: 'In neuem Tab öffnen',
    label: 'Live-Demo',
    title: 'Interaktiver loam.dev-Demo-Report',
  },
}[lang];
---

<section class="scene demo-report" aria-labelledby="demo-report-title" data-testid="how-demo-report">
  <div class="wrap">
    <div class="demo-report__head">
      <p class="label">{copy.label}</p>
      <h2 id="demo-report-title" class="h2">{copy.heading}</h2>
      <p class="body-copy demo-report__body" set:html={copy.body} />
    </div>

    <figure class="report-frame rv">
      <div class="frame-bar">
        <span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="frame-title">loam-report.html — shopcart</span>
        <a class="btn btn--ghost btn--sm frame-open" href="/demo-report" target="_blank" rel="noopener" id="demo-report-open" data-testid="demo-report-open">
          {copy.open}<span class="ext" aria-hidden="true">↗</span>
        </a>
      </div>
      <iframe
        class="report-embed"
        src="/demo-report"
        title={copy.title}
        loading="lazy"
      ></iframe>
    </figure>
  </div>
</section>

<style>
  /* Full-width scene: the frame spans the page column (up to --page-max), so
     the embedded report keeps its own two-column layout (it stacks below
     920px) on every desktop width, from 1440 up to ultrawide. */
  .demo-report__head { display: grid; gap: var(--s-4); max-width: 62rem; margin-bottom: var(--s-7); }
  .demo-report__body { color: var(--dim); max-width: var(--measure); }
  .report-frame {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 40px 120px rgba(0, 0, 0, .55);
  }
  .frame-bar {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .55rem .6rem .55rem 1rem;
    background: linear-gradient(180deg, #16181d, #111216);
    border-bottom: 1px solid var(--line);
  }
  .frame-title {
    font: 500 .78rem var(--font-mono);
    color: var(--dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .frame-open { margin-left: auto; flex: none; }
  /* Viewport-relative so the frame keeps some page around it (the report
     scrolls internally, so a full-height frame would trap the wheel); the
     plain px height is the fallback for engines without svh. */
  .report-embed {
    display: block;
    width: 100%;
    height: 660px;
    height: clamp(460px, 78svh, 920px);
    border: 0;
    background: #0c0d10;
  }
  @media (max-width: 920px) {
    .report-embed {
      height: 560px;
      height: clamp(420px, 68svh, 600px);
    }
  }
  @media (max-width: 460px) {
    .frame-title { display: none; }
  }
</style>

<script is:inline>
  document.getElementById('demo-report-open')?.addEventListener('click',function(){
    (window._paq||[]).push(["trackEvent","Engagement","Demo-Report geöffnet","report"]);
  });
</script>
