---
/**
 * GitHubStars — compact GitHub star badge in the site header (every page, EN + DE).
 * Build-time: fetches star count from GitHub API with a short timeout;
 * on any failure renders a neutral CTA without a number (no build break).
 * Client-side: updates the count on load via direct GitHub API fetch (no proxy).
 */

interface Props {
  /** Baked star count from the build-time fetch, or null on failure. */
  initialCount: number | null;
  /** Locale-aware aria label for screen readers. */
  ariaLabel: string;
}

const { initialCount, ariaLabel } = Astro.props;

const REPO = 'silvio-l/loam';
const GITHUB_URL = `https://github.com/${REPO}`;
---

<a
  class="gh-stars"
  data-testid="github-stars-link"
  href={GITHUB_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  data-repo={REPO}
>
  <span class="gh-icon" aria-hidden="true">
    <!-- GitHub mark (simplified SVG) -->
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
        0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
        -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
        .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
        -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0
        1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
        1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01
        1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
    </svg>
  </span>
  <span class="gh-label">GitHub</span>
  {initialCount !== null && (
    <span class="gh-count" id="gh-count">{initialCount.toLocaleString('en')}</span>
  )}
  {initialCount === null && (
    <span class="gh-count" id="gh-count" style="display:none"></span>
  )}
</a>

<script is:inline>
  (function () {
    var el = document.getElementById('gh-count');
    var link = el && el.closest('[data-repo]');
    var repo = link && link.getAttribute('data-repo');
    if (!repo) return;

    fetch('https://api.github.com/repos/' + repo)
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (data) {
        var count = data && typeof data.stargazers_count === 'number'
          ? data.stargazers_count
          : null;
        if (count !== null && el) {
          el.textContent = count.toLocaleString('en');
          el.style.display = '';
        }
      })
      .catch(function () { /* leave baked value intact on failure */ });
  })();
</script>

<style is:global>
  /* Header badge: same height and type as the other header controls. */
  .gh-stars {
    display: inline-flex; align-items: center; gap: .5rem; min-height: 2.5rem;
    padding: 0 .85rem; border: 1px solid var(--line-strong); border-radius: 999px;
    font: 500 .74rem / 1 var(--font-mono); letter-spacing: .04em;
    color: var(--ink); text-decoration: none; transition: color .18s, border-color .18s;
  }
  .gh-stars:hover, .gh-stars:focus-visible { color: var(--green); border-color: var(--green-a50); }
  .gh-icon { display: flex; color: var(--ink); flex-shrink: 0; }
  .gh-stars:hover .gh-icon, .gh-stars:focus-visible .gh-icon { color: var(--green); }
  .gh-label { white-space: nowrap; }
  .gh-count { display: inline-flex; align-items: center; gap: .3rem; padding-left: .55rem;
    border-left: 1px solid var(--line-strong); color: var(--green); font-weight: 600; }
  .gh-count::before { content: "★"; font-size: .9em; }
  @media (max-width: 620px) { .gh-label { display: none; } }
</style>
