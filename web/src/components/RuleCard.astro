---
/**
 * RuleCard.astro — displays one rule from the loam.dev catalogue.
 *
 * Props:
 *   ruleId     — canonical rule identifier (e.g. 'unused-public-exports')
 *   title      — human-readable rule name
 *   status     — 'live' | 'planned'
 *   badgeLabel — localised status label (e.g. 'live' / 'geplant')
 *   profile    — optional gate profile of a live rule: 'core' | 'strict'
 *   profileLabel — localised label for the profile badge
 *   slopLabel  — localised label for the bad-code tab
 *   cleanLabel — localised label for the clean-code tab
 *   description — prose description of what the rule detects
 *   slopCode   — Dart snippet illustrating the bad pattern
 *   cleanCode  — Dart snippet illustrating the clean version
 */

interface Props {
  ruleId: string;
  title: string;
  status: 'live' | 'planned';
  badgeLabel: string;
  profile?: 'core' | 'strict';
  profileLabel?: string;
  slopLabel: string;
  cleanLabel: string;
  description: string;
  slopCode: string;
  cleanCode: string;
}

const { ruleId, title, status, badgeLabel, profile, profileLabel, slopLabel, cleanLabel, description, slopCode, cleanCode } = Astro.props;
// Long slash-joined API lists (Image/Image.asset/…) get a break opportunity
// after each slash, so they wrap on narrow screens instead of widening the row.
const descParts = description.split('/');
---

<article id={ruleId} class={`rule-card rule-card--${status}`} aria-labelledby={`${ruleId}-title`} data-testid={`rule-card-${ruleId}`}>
  <div class="rule-card__meta">
    <div class="rule-card__header">
      <a class="rule-card__id" href={`#${ruleId}`} data-testid={`rule-card-link-${ruleId}`}>{ruleId}</a>
      <span class={`rule-card__badge rule-card__badge--${status}`}>{badgeLabel}</span>
      {profile && <span class={`rule-card__badge rule-card__badge--${profile}`} data-testid={`rule-profile-${ruleId}`}>{profileLabel}</span>}
    </div>
    <h4 id={`${ruleId}-title`} class="rule-card__title">{title}</h4>
    <p class="rule-card__desc">{descParts.map((part, i) => (i === 0 ? part : <>/<wbr />{part}</>))}</p>
  </div>
  <div class="rule-card__examples">
    <div class="example-block example-block--slop">
      <span class="example-label">{slopLabel}</span>
      <pre tabindex="0"><code>{slopCode}</code></pre>
    </div>
    <div class="example-block example-block--clean">
      <span class="example-label">{cleanLabel}</span>
      <pre tabindex="0"><code>{cleanCode}</code></pre>
    </div>
  </div>
</article>

<style is:global>
  /* One rule = one row: meta on the left, flagged vs. clean side by side on
     wide screens; stacked on narrow ones. Deep-link target for /rules/#id
     (from the HTML report and the home page), so it keeps clear of the
     sticky header. */
  .rule-card {
    display: grid;
    gap: var(--s-5) var(--col-gap);
    grid-template-columns: minmax(0, 1fr);
    padding: clamp(1.4rem, 1rem + 1.4vw, 2.4rem) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + var(--s-5));
  }
  @media (min-width: 1800px) {
    .rule-card { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: start; }
  }
  .rule-card:target { background: linear-gradient(90deg, var(--green-a12), transparent 70%); box-shadow: inset 3px 0 0 var(--green); padding-left: var(--s-4); }
  .rule-card__meta { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); align-content: start; min-width: 0; }
  .rule-card__header { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  .rule-card__id { font: 600 .95rem / 1.3 var(--font-mono); color: var(--ink); text-decoration: none; overflow-wrap: anywhere; margin-right: .2rem; }
  .rule-card__id:hover, .rule-card__id:focus-visible { color: var(--green); }
  .rule-card__badge { font: 600 .66rem / 1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase;
    padding: .32rem .5rem; border-radius: 6px; border: 1px solid var(--line-strong); color: var(--dim); }
  .rule-card__badge--live { color: var(--bg); background: var(--green); border-color: var(--green); }
  .rule-card__badge--planned { color: var(--ink); border-style: dashed; }
  .rule-card__badge--core { color: var(--green); border-color: var(--green-a50); }
  .rule-card__badge--strict { color: var(--ink); border-color: var(--line-strong); }
  .rule-card__title { font: 600 clamp(1.25rem, 1rem + .8vw, 1.7rem) / 1.15 var(--font-display); letter-spacing: -.02em; color: var(--ink); }
  .rule-card__desc { color: var(--dim); max-width: 72ch; text-wrap: pretty; overflow-wrap: break-word; }
  .rule-card__examples { display: grid; gap: var(--s-3); grid-template-columns: minmax(0, 1fr); min-width: 0; }
  @media (min-width: 760px) { .rule-card__examples { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .example-block { min-width: 0; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: #0b0c0f; overflow: hidden; }
  .example-block--slop { border-color: rgba(224, 120, 95, .35); }
  .example-block--clean { border-color: var(--green-a40); }
  .example-label { display: block; padding: .5rem .8rem; font: 600 .66rem / 1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase;
    border-bottom: 1px solid var(--line); }
  .example-block--slop .example-label { color: var(--flag); background: var(--flag-a14); }
  .example-block--clean .example-label { color: var(--green); background: var(--green-a12); }
  .example-block pre { margin: 0; padding: .9rem 1rem 1rem; overflow-x: auto; font: 400 var(--t-code) / 1.6 var(--font-mono); color: #c9c6ba;
    scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .example-block pre code { background: none; padding: 0; font: inherit; color: inherit; }
  .example-block pre:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
</style>
