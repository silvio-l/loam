---
/**
 * LanguageSwitcher — navigates page-accurately to the counterpart URL.
 * localStorage is used only to pre-populate the switcher label preference,
 * never as an automatic redirect.
 */
import { counterpartUrl } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const targetLocale: Locale = lang === 'en' ? 'de' : 'en';
const switchUrl = counterpartUrl(path, targetLocale);
const label = t(lang, 'switcher.label');
const ariaLabel = t(lang, 'switcher.ariaLabel');
---

<nav class="lang" aria-label={lang === 'de' ? 'Sprache' : 'Language'}>
  <span class="lang__current" aria-current="true">{lang.toUpperCase()}</span>
  <span class="lang__sep" aria-hidden="true">/</span>
  <a
    class="lang-switch"
    data-testid="layout-lang-switch"
    href={switchUrl}
    aria-label={ariaLabel}
    data-target-locale={targetLocale}
  >{label}</a>
</nav>

<script is:inline>
  // Pre-populate: if the user previously chose a locale, highlight the switcher
  // visually. This is purely cosmetic — no redirect happens automatically.
  (function () {
    var pref = localStorage.getItem('loam-locale');
    if (!pref) return;
    var el = document.querySelector('.lang-switch');
    if (el && el.getAttribute('data-target-locale') !== pref) {
      el.classList.add('lang-active');
    }
  })();
  // Store chosen locale when user clicks
  document.querySelector('.lang-switch')?.addEventListener('click', function () {
    var locale = this.getAttribute('data-target-locale');
    if (locale) localStorage.setItem('loam-locale', locale);
  });
</script>

<style is:global>
  /* Quiet text toggle: current language bright, the other one a link.
     The link keeps a 2.5rem target (WCAG 2.5.8). */
  .lang { display: inline-flex; align-items: center; gap: .15rem;
    font: 500 .74rem / 1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .lang__current { color: var(--ink); padding: 0 .2rem; }
  .lang__sep { color: var(--line-strong); }
  .lang-switch { display: inline-flex; align-items: center; justify-content: center;
    min-height: 2.5rem; min-width: 2.5rem; padding: 0 .2rem;
    color: var(--dim); text-decoration: none; transition: color .18s; }
  .lang-switch:hover, .lang-switch:focus-visible, .lang-switch.lang-active { color: var(--green); }
</style>
