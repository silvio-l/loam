---
import Layout from '../../layouts/Layout.astro';
import BrandMark from '../../components/BrandMark.astro';
import ReportPreview from '../../components/ReportPreview.astro';
import { t } from '../../i18n/ui';
import '../../styles/home.css';

const newTab = t('de', 'a11y.newTab');
---

<Layout
  lang="de"
  title="loam.dev — Codebase-Intelligence & Anti-AI-Slop für Dart & Flutter"
  description="Was dart analyze nicht meldet, findet loam.dev: toten Code, Import-Zyklen, Kopien, AI-Slop und Lücken in der Barrierefreiheit in Dart- und Flutter-Projekten. In der CI schlägt es nur bei neuen Findings an."
  path="/de/"
>
  <span id="status" class="sr-only" role="status" aria-live="polite"></span>

  <!-- Scene 0 · Hero (DE). Structure mirrors src/pages/index.astro; styles: src/styles/home.css. -->
  <section class="hero" aria-labelledby="hero-title" data-testid="home-hero">
    <div class="wrap hero__grid">
      <div class="hero__copy intro">
        <div class="hero__brand" aria-hidden="true" data-testid="home-hero-brand"><BrandMark class="hero__mark" /><img class="hero__wordmark" src="/wordmark.svg" alt="" width="480" height="120"></div>
        <p class="label">Codebase-Intelligence &amp; Anti-AI-Slop · Dart &amp; Flutter</p>
        <h1 id="hero-title" class="display hero__title">Was <span class="accent hero__tool">dart analyze</span> nicht meldet, findet loam.dev.</h1>
        <p class="lead hero__lead">loam.dev ist ein CLI für Dart- und Flutter-Projekte, die du mit KI-Agenten entwickelst.
          Es prüft das ganze Projekt auf strukturellen Drift, AI-Slop und Lücken in der Barrierefreiheit —
          und in der CI schlägt es nur bei neuen Findings an.</p>
        <div class="hero__install">
          <div class="cmd">
            <span class="cmd__p" aria-hidden="true">$</span><span class="cmd__t" id="cmd">dart pub global activate loam</span>
            <button class="cmd__copy" id="copy" type="button" data-testid="home-copy" data-copy-target="cmd" data-done="kopiert" data-failed="Kopieren fehlgeschlagen" aria-label="Installationsbefehl kopieren">kopieren</button>
          </div>
          <p class="cmd-note next">Starte danach <code>loam&nbsp;scan</code> in deinem Projekt. Frühe Vorschau · 20 aktive Rules · kostenlos · MIT · ohne Konto.</p>
          <p class="cmd-note hero__brew">Homebrew auf Apple-Silicon-Macs &amp; Linux: <code id="cmd-brew-hero">brew install silvio-l/loam/loam</code>
            <button class="mini-copy" type="button" data-testid="home-copy-brew" data-copy-target="cmd-brew-hero" data-track="Install brew" data-done="kopiert" data-failed="Kopieren fehlgeschlagen" aria-label="Homebrew-Installationsbefehl kopieren">kopieren</button></p>
        </div>
        <nav class="hero__links" data-testid="home-links" aria-label="Projekt-Links">
          <a class="link" href="https://pub.dev/packages/loam" data-testid="home-link-pubdev">pub.dev</a>
          <a class="link" href="https://github.com/silvio-l/loam" data-testid="home-link-github">GitHub</a>
          <a class="link" href="/de/developer-guide/" data-testid="home-link-docs">Doku</a>
          <a class="link" href="/demo-report" data-testid="home-link-report" data-track="report" target="_blank" rel="noopener">Live-Demo-Report<span class="ext" aria-hidden="true">↗</span><span class="sr-only"> {newTab}</span></a>
          <a class="link" href="mailto:silvio-lindstedt@outlook.com" data-testid="home-link-contact">Kontakt</a>
          <button class="link sharelink" id="share" data-testid="home-share" type="button" data-share="https://getloam.dev/" data-share-text="Codebase-Intelligence & Anti-AI-Slop für Dart & Flutter." data-done="Link kopiert" data-failed="Kopieren fehlgeschlagen">teilen</button>
        </nav>
      </div>

      <figure class="hero__visual" aria-label="Beispiel: Ausgabe von loam scan in einem kleinen Demo-Projekt">
        <div class="term term--hero">
          <div class="term__bar"><span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="term__title">~/shopcart — loam scan</span></div>
          <pre class="term__body"><span class="l"><span class="c-p">$</span> <span class="c-cmd">loam scan</span></span><span class="l c-dim">shopcart · source: lib, bin</span><span class="l"> </span><span class="l c-file">lib/services/cart_service.dart</span><span class="l">  1     <span class="c-warn">warning</span>  <span class="c-rule">circular-dependencies</span></span><span class="l c-dim">        cart_service.dart ⇄ checkout_service.dart</span><span class="l c-file">lib/services/order_notifier.dart</span><span class="l">  9     <span class="c-warn">warning</span>  <span class="c-rule">code-duplicates</span></span><span class="l c-dim">        2 occurrences of duplicated block (59 tokens)</span><span class="l c-file">lib/services/pricing_engine.dart</span><span class="l">  5     <span class="c-warn">warning</span>  <span class="c-rule">complexity-hotspots</span></span><span class="l c-dim">        PricingEngine.discountFor: cyclomatic=27, cognitive=39</span><span class="l"> </span><span class="l c-cmd">3 findings (warning: 3)</span></pre>
        </div>
        <figcaption class="hero__caption">Echte, gekürzte Ausgabe von <code>loam scan</code> im Demo-Projekt hinter dem <a class="link" href="/demo-report" data-track="report" data-testid="home-hero-report" target="_blank" rel="noopener">Demo-Report<span class="ext" aria-hidden="true">↗</span><span class="sr-only"> {newTab}</span></a>.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Scene 1 · Problem: a valid Dart file whose problems are marked line by line. -->
  <section class="scene problem" aria-labelledby="problem-title" data-testid="home-problem">
    <div class="problem__pin">
      <div class="wrap problem__grid">
        <div class="problem__text">
          <p class="label">Das Problem</p>
          <h2 id="problem-title" class="h2">Gültiges Dart <span class="accent">ist noch kein sauberer Code.</span></h2>
          <div class="body-copy">
            <p>
              Baut ein KI-Agent ein Feature, sieht die fertige Funktion meist gut aus. Was dabei
              leicht durchrutscht: eine Hilfsfunktion, die es schon gibt und die unter neuem Namen
              kopiert wurde, ein leerer <code>catch</code>, der den Fehler verschluckt, eine
              öffentliche Klasse, die niemand nutzt, ein Icon-Button ohne zugänglichen Namen.
            </p>
            <p>
              Das alles ist gültiges Dart, und <code>dart analyze</code> lässt es durch: Es prüft
              deinen Code weitgehend Datei für Datei, nicht das Projekt als Ganzes. Schaut niemand
              hin, häuft sich das an, bis sich die Codebasis nur noch mühsam ändern lässt.
            </p>
          </div>
        </div>
        <figure class="codefile problem__code">
          <div class="codefile__bar"><span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="codefile__name">lib/checkout/checkout_page.dart</span><span class="problem__count" aria-hidden="true">Findings</span></div>
          <pre class="codefile__body"><code><span class="ln">String formatPrice(int cents) =&gt;</span><span class="ln">    '$&#123;(cents / 100).toStringAsFixed(2)&#125; €';</span><span class="ln"> </span><span class="ln flag f1"><span class="flag__n" aria-hidden="true">1</span>String priceLabel(int cents) =&gt;</span><span class="ln flag f1">    '$&#123;(cents / 100).toStringAsFixed(2)&#125; €';</span><span class="ln"> </span><span class="ln">Future&lt;void&gt; submit(Order order) async &#123;</span><span class="ln">  try &#123;</span><span class="ln">    await api.send(order);</span><span class="ln flag f2"><span class="flag__n" aria-hidden="true">2</span>  &#125; catch (e) &#123;</span><span class="ln flag f2">    // TODO: handle error</span><span class="ln flag f2">  &#125;</span><span class="ln">&#125;</span><span class="ln"> </span><span class="ln flag f3"><span class="flag__n" aria-hidden="true">3</span>class CheckoutAnalyticsHelper &#123;</span><span class="ln flag f3">  void track(String event) &#123;&#125;</span><span class="ln flag f3">&#125;</span><span class="ln"> </span><span class="ln">IconButton(</span><span class="ln flag f4"><span class="flag__n" aria-hidden="true">4</span>  icon: const Icon(Icons.delete),</span><span class="ln">  onPressed: onRemove,</span><span class="ln">),</span></code></pre>
          <figcaption class="codefile__legend">
            <ol>
              <li class="f1"><span class="flag__n">1</span><span><b>eine Hilfsfunktion, unter neuem Namen kopiert</b> <a class="rule-id" href="/de/rules/#code-duplicates" data-testid="home-flag-rule-code-duplicates">code-duplicates</a></span></li>
              <li class="f2"><span class="flag__n">2</span><span><b>ein leerer <code>catch</code>, der den Fehler verschluckt</b> <a class="rule-id" href="/de/rules/#slop-empty-catch" data-testid="home-flag-rule-slop-empty-catch">slop-empty-catch</a></span></li>
              <li class="f3"><span class="flag__n">3</span><span><b>eine öffentliche Klasse, die niemand nutzt</b> <a class="rule-id" href="/de/rules/#unused-public-exports" data-testid="home-flag-rule-unused-public-exports">unused-public-exports</a></span></li>
              <li class="f4"><span class="flag__n">4</span><span><b>ein Icon-Button ohne zugänglichen Namen</b> <a class="rule-id" href="/de/rules/#a11y-icon-button-label" data-testid="home-flag-rule-a11y-icon-button-label">a11y-icon-button-label</a></span></li>
            </ol>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Scene 2 · What it finds: three strata, one run. -->
  <section class="scene finds" aria-labelledby="finds-title" data-testid="home-finds">
    <div class="wrap finds__head">
      <p class="label">Was loam.dev findet</p>
      <h2 id="finds-title" class="h2">Drei Arten von Problemen, <span class="accent">ein Scan.</span></h2>
    </div>
    <div class="strata">
      <article class="stratum stratum--1 rv" aria-labelledby="stratum-drift">
        <div class="wrap stratum__grid">
          <span class="stratum__depth" aria-hidden="true">01</span>
          <h3 id="stratum-drift" class="h3 stratum__title">Struktureller Drift</h3>
          <p class="stratum__text">
            Öffentliche API, die im ganzen Projekt niemand nutzt, Bibliotheken, die sich im Kreis
            importieren, Imports über die Layer-Grenzen hinweg, die du in <code>loam.yaml</code> festlegst, duplizierter Code — umbenannte Kopien eingeschlossen — und
            Komplexitäts-Hotspots, zusammengefasst im <code>loam health</code>-Score.
          </p>
          <ul class="rule-chips" aria-label="Rules">
            <li><a href="/de/rules/#unused-public-exports" data-testid="home-rule-chip-unused-public-exports">unused-public-exports</a></li>
            <li><a href="/de/rules/#circular-dependencies" data-testid="home-rule-chip-circular-dependencies">circular-dependencies</a></li>
            <li><a href="/de/rules/#architecture-boundaries" data-testid="home-rule-chip-architecture-boundaries">architecture-boundaries</a></li>
            <li><a href="/de/rules/#code-duplicates" data-testid="home-rule-chip-code-duplicates">code-duplicates</a></li>
            <li><a href="/de/rules/#complexity-hotspots" data-testid="home-rule-chip-complexity-hotspots">complexity-hotspots</a></li>
          </ul>
        </div>
      </article>
      <article class="stratum stratum--2 rv" aria-labelledby="stratum-slop">
        <div class="wrap stratum__grid">
          <span class="stratum__depth" aria-hidden="true">02</span>
          <h3 id="stratum-slop" class="h3 stratum__title">AI-Slop</h3>
          <p class="stratum__text">
            Leere <code>catch</code>-Blöcke oder solche mit nur einem Kommentar, <code>// ignore:</code> ohne
            Begründung, Kommentare, die den Code bloß wiederholen oder Schritt für Schritt
            nacherzählen, Platzhalter wie <code>// ... rest of code</code>, Funktionen, die nur <code>UnimplementedError</code> werfen, Tests, die nichts prüfen (<code>expect(true, isTrue)</code>), <code>setState</code> nach einem <code>await</code> ohne <code>mounted</code>-Prüfung, und Secrets im Klartext in Strings — ohne den
            Wert je auszugeben.
          </p>
          <ul class="rule-chips" aria-label="Rules">
            <li><a href="/de/rules/#slop-empty-catch" data-testid="home-rule-chip-slop-empty-catch">slop-empty-catch</a></li>
            <li><a href="/de/rules/#slop-unjustified-ignore" data-testid="home-rule-chip-slop-unjustified-ignore">slop-unjustified-ignore</a></li>
            <li><a href="/de/rules/#slop-narrative-comment" data-testid="home-rule-chip-slop-narrative-comment">slop-narrative-comment</a></li>
            <li><a href="/de/rules/#slop-workflow-narration-comment" data-testid="home-rule-chip-slop-workflow-narration-comment">slop-workflow-narration-comment</a></li>
            <li><a href="/de/rules/#slop-placeholder-comment" data-testid="home-rule-chip-slop-placeholder-comment">slop-placeholder-comment</a></li>
            <li><a href="/de/rules/#slop-unimplemented-stub" data-testid="home-rule-chip-slop-unimplemented-stub">slop-unimplemented-stub</a></li>
            <li><a href="/de/rules/#slop-tautological-assertion" data-testid="home-rule-chip-slop-tautological-assertion">slop-tautological-assertion</a></li>
            <li><a href="/de/rules/#slop-undisposed-resource" data-testid="home-rule-chip-slop-undisposed-resource">slop-undisposed-resource</a></li>
            <li><a href="/de/rules/#slop-assertion-free-test" data-testid="home-rule-chip-slop-assertion-free-test">slop-assertion-free-test</a></li>
            <li><a href="/de/rules/#slop-setstate-after-async-gap" data-testid="home-rule-chip-slop-setstate-after-async-gap">slop-setstate-after-async-gap</a></li>
            <li><a href="/de/rules/#hardcoded-secrets" data-testid="home-rule-chip-hardcoded-secrets">hardcoded-secrets</a></li>
          </ul>
        </div>
      </article>
      <article class="stratum stratum--3 rv" aria-labelledby="stratum-a11y">
        <div class="wrap stratum__grid">
          <span class="stratum__depth" aria-hidden="true">03</span>
          <h3 id="stratum-a11y" class="h3 stratum__title">Lücken in der Barrierefreiheit</h3>
          <p class="stratum__text">
            Bilder ohne semantisches Label, Icon-Buttons und antippbare Widgets ohne zugänglichen
            Namen, Formularfelder ohne Beschriftung — die Lücken hinter WCAG 1.1.1, 4.1.2 und 3.3.2.
          </p>
          <ul class="rule-chips" aria-label="Rules">
            <li><a href="/de/rules/#a11y-image-label" data-testid="home-rule-chip-a11y-image-label">a11y-image-label</a></li>
            <li><a href="/de/rules/#a11y-icon-button-label" data-testid="home-rule-chip-a11y-icon-button-label">a11y-icon-button-label</a></li>
            <li><a href="/de/rules/#a11y-interactive-semantics" data-testid="home-rule-chip-a11y-interactive-semantics">a11y-interactive-semantics</a></li>
            <li><a href="/de/rules/#a11y-form-field-label" data-testid="home-rule-chip-a11y-form-field-label">a11y-form-field-label</a></li>
          </ul>
        </div>
      </article>
    </div>
    <div class="wrap finds__more">
      <a class="link link--arrow" href="/de/rules/" data-testid="home-finds-rules">Alle 20 aktiven Rules ansehen, jede mit gemeldetem und sauberem Beispiel</a>
    </div>
  </section>

  <!-- Scene 3 · How it works: the ratchet — scan, baseline, gate. -->
  <section class="scene how" aria-labelledby="how-title" data-testid="home-how">
    <div class="wrap how__grid">
      <header class="how__head">
        <p class="label">So funktioniert’s</p>
        <h2 id="how-title" class="h2">Einmal alles prüfen. <span class="accent">Danach nur Neues blockieren.</span></h2>
      </header>
      <ol class="ratchet">
        <li class="ratchet__step rv">
          <div class="ratchet__text">
            <span class="ratchet__n" aria-hidden="true">01</span>
            <h3 class="h3">Bestand prüfen.</h3>
            <p><code>loam scan</code> lässt alle Rules über das
              ganze Projekt laufen und listet jedes Finding. Behebe, was dir jetzt wichtig ist.</p>
          </div>
          <div class="term term--step" aria-label="Beispielausgabe">
            <pre class="term__body"><span class="l"><span class="c-p">$</span> <span class="c-cmd">loam scan</span></span><span class="l">  <span class="c-warn">warning</span>  <span class="c-rule">circular-dependencies</span></span><span class="l">  <span class="c-warn">warning</span>  <span class="c-rule">code-duplicates</span></span><span class="l">  <span class="c-warn">warning</span>  <span class="c-rule">complexity-hotspots</span></span><span class="l c-cmd">3 findings (warning: 3)</span></pre>
          </div>
        </li>
        <li class="ratchet__step rv">
          <div class="ratchet__text">
            <span class="ratchet__n" aria-hidden="true">02</span>
            <h3 class="h3">Akzeptiertes festhalten.</h3>
            <p><code>loam baseline --write</code> hält die
              akzeptierten Findings in <code>baseline.json</code> fest. Committe die Datei.</p>
          </div>
          <div class="term term--step" aria-label="Beispielausgabe">
            <pre class="term__body"><span class="l"><span class="c-p">$</span> <span class="c-cmd">loam baseline --write</span></span><span class="l">loam baseline: wrote 3 findings to baseline.json</span><span class="l"><span class="c-p">$</span> <span class="c-cmd">git add baseline.json</span></span></pre>
          </div>
        </li>
        <li class="ratchet__step rv">
          <div class="ratchet__text">
            <span class="ratchet__n" aria-hidden="true">03</span>
            <h3 class="h3">In der CI nur Neues blockieren.</h3>
            <p><code>loam gate</code> in der CI schlägt nur bei
              neuen Findings blockierender Rules fehl. Dein Bestand färbt den Build nicht rot, und
              der Score kann nur besser werden.</p>
          </div>
          <div class="term term--step" aria-label="Beispielausgabe">
            <pre class="term__body"><span class="l"><span class="c-p">$</span> <span class="c-cmd">loam gate</span></span><span class="l c-ok"># exit 0 · nichts Neues</span><span class="l c-dim"># …der Agent ergänzt einen leeren catch…</span><span class="l"><span class="c-p">$</span> <span class="c-cmd">loam gate</span></span><span class="l c-file">lib/models/order.dart</span><span class="l">  18:5  <span class="c-warn">warning</span>  <span class="c-rule">slop-empty-catch</span></span><span class="l c-bad"># exit 1 · ein neues Finding</span></pre>
          </div>
        </li>
      </ol>
      <div class="how__after body-copy">
        <p>
          Neues Projekt? <code>loam gate --absolute</code> ignoriert die Baseline und lässt gar
          keine blockierenden Findings zu. Während du programmierst, wiederholt <code>loam watch</code> die
          Prüfung bei jedem Speichern und zeigt, was neu oder behoben ist.
        </p>
        <p><a class="link link--arrow" href="/de/how-it-works/" data-testid="home-how-more">Wie loam.dev dein Projekt analysiert</a></p>
      </div>
    </div>
  </section>

  <!-- Scene 4 · Proof: the real report, framed large. -->
  <section class="scene proof" aria-labelledby="proof-title" data-testid="home-proof">
    <div class="wrap proof__head">
      <p class="label">Belege</p>
      <h2 id="proof-title" class="h2">Prüf die Ergebnisse <span class="accent">selbst.</span></h2>
    </div>
    <div class="wrap">
      <ReportPreview lang="de" />
    </div>
    <div class="wrap">
      <ul class="proof__list">
        <li class="rv"><h3 class="h3">Der Live-Demo-Report.</h3><p>Der <a class="link" href="/demo-report" data-testid="home-proof-report" data-track="report" target="_blank" rel="noopener">Demo-Report<span class="ext" aria-hidden="true">↗</span><span class="sr-only"> {newTab}</span></a> ist exakt die <code>html</code>-Ausgabe von loam.dev, erzeugt aus einem absichtlich
          unaufgeräumten Demo-Projekt. Filtern, Findings auswählen, Fix-Prompt kopieren.</p></li>
        <li class="rv"><h3 class="h3">loam.dev prüft sich selbst.</h3><p>Bei jedem Push läuft das eigene Gate
          über den eigenen Code — alle Rules, Absolute Mode, null Findings erlaubt.</p></li>
        <li class="rv"><h3 class="h3">Open Source, MIT.</h3><p>Jede Rule liegt lesbar auf <a class="link" href="https://github.com/silvio-l/loam" data-testid="home-proof-github">GitHub</a>.
          Kein Konto, kein Lizenzschlüssel, kein Abo.</p></li>
        <li class="rv"><h3 class="h3">Frühe Vorschau.</h3><p>Version 0.1.16 ist eine frühe Vorschau: 20 Rules
          sind aktiv, eine weitere ist geplant und auch so gekennzeichnet.</p></li>
      </ul>
    </div>
  </section>

  <!-- Scene 5 · FAQ: objections, answered. Native <details>, works without JS. -->
  <section class="scene faq" aria-labelledby="faq-title" data-testid="home-faq">
    <div class="wrap faq__grid">
      <header class="faq__head">
        <p class="label">FAQ</p>
        <h2 id="faq-title" class="h2">Fragen vor der Installation</h2>
      </header>
      <div class="faq__list">
        <details class="qa" data-testid="home-faq-analyze" open>
          <summary><h3 class="qa__q">Ersetzt es <code>dart analyze</code>?</h3></summary>
          <div class="qa__a"><p>
            Nein, loam.dev ergänzt es. Lass <code>dart analyze</code> weiter für Typen und Lints
            laufen. loam.dev betrachtet das ganze Projekt auf einmal — Referenzen, Imports, Kopien
            über Dateien hinweg — und will nicht wiederholen, was der Analyzer schon meldet.
          </p></div>
        </details>
        <details class="qa" data-testid="home-faq-legacy">
          <summary><h3 class="qa__q">Kann ich es in ein bestehendes Projekt holen, ohne dass die CI rot wird?</h3></summary>
          <div class="qa__a"><p>
            Nein. Der Ratchet ist der Standard: Du frierst die heutigen Findings in einer Baseline
            ein, und nur neue lassen das Gate scheitern. Den Altbestand räumst du auf, wann es
            dir passt.
          </p></div>
        </details>
        <details class="qa" data-testid="home-faq-noise">
          <summary><h3 class="qa__q">Wie viele Fehlalarme gibt es?</h3></summary>
          <div class="qa__a"><p>
            Standardmäßig kann nur das Profil <code>core</code> das Gate scheitern lassen: sieben
            Rules, ausgelegt auf nahezu null Fehlalarme. Heuristische und schwellenwertbasierte
            Rules laufen mit und erscheinen als Hinweis; das Gate scheitern lassen können sie erst
            mit <code>--profile strict</code>. Code von Generatoren wie freezed,
            json_serializable, Drift und Riverpod wird automatisch erkannt, und <code>// loam-ignore: &lt;rule&gt; – &lt;reason&gt;</code> schaltet ein einzelnes
            Finding stumm — die Begründung ist Pflicht.
          </p></div>
        </details>
        <details class="qa" data-testid="home-faq-privacy">
          <summary><h3 class="qa__q">Verlässt mein Code meinen Rechner?</h3></summary>
          <div class="qa__a"><p>
            Nein. Die Analyse läuft lokal und offline, dein Code wird nie hochgeladen, und ein Konto
            brauchst du nicht. Davon abgesehen prüft loam.dev einmal am Tag bei pub.dev auf Updates —
            in der CI aus und überall abschaltbar.
          </p></div>
        </details>
        <details class="qa" data-testid="home-faq-ai">
          <summary><h3 class="qa__q">Bewertet KI meinen Code?</h3></summary>
          <div class="qa__a"><p>
            Heute nicht. Alle 20 aktiven Rules sind deterministisch: gleicher Code und gleiche
            Ruleset-Version ergeben immer dieselben Findings. Eine geplante, optionale LLM-Rule
            wird mit deinem eigenen API-Key laufen und jedes Urteil cachen, damit das Gate
            reproduzierbar bleibt.
          </p></div>
        </details>
        <details class="qa" data-testid="home-faq-agent">
          <summary><h3 class="qa__q">Wie arbeitet es mit meinem KI-Agenten zusammen?</h3></summary>
          <div class="qa__a"><p>
            <code>--format agent</code> gibt deinem Agenten eine kurze, begrenzte Liste; <code>json</code> und <code>sarif</code> versorgen Tools und CI. Im HTML-Report wählst
            du Findings aus und kopierst einen fertigen Fix-Prompt. Nach einem Lauf schlägt
            loam.dev je Problemklasse eine vorbeugende Anweisung für die dauerhaften Regeln deines
            Agenten vor (etwa in <code>CLAUDE.md</code>) — bearbeitet diese Dateien aber nie selbst.
          </p></div>
        </details>
        <details class="qa" data-testid="home-faq-cost">
          <summary><h3 class="qa__q">Was kostet es, und wo läuft es?</h3></summary>
          <div class="qa__a"><p>
            Nichts — es steht unter MIT-Lizenz. Es läuft auf macOS, Linux und Windows: Installiere
            es überall per Dart pub oder auf Apple-Silicon-Macs und Linux per Homebrew.
          </p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Scene 6 · Install: the sprout grows out of the soil. -->
  <section class="scene start" id="install" aria-labelledby="start-title" data-testid="home-start">
    <div class="wrap start__grid">
      <div class="start__art" aria-hidden="true"><BrandMark class="start__mark" /></div>
      <div class="start__body">
        <p class="label">Loslegen</p>
        <h2 id="start-title" class="h2">Starte deinen ersten Scan.</h2>
        <div class="start__cmds">
          <div class="cmd">
            <span class="cmd__p" aria-hidden="true">$</span><span class="cmd__t" id="cmd-start-pub">dart pub global activate loam</span>
            <button class="cmd__copy" type="button" data-testid="home-start-copy-pub" data-copy-target="cmd-start-pub" data-done="kopiert" data-failed="Kopieren fehlgeschlagen" aria-label="Installationsbefehl kopieren">kopieren</button>
          </div>
          <div class="cmd cmd--secondary">
            <span class="cmd__p" aria-hidden="true">$</span><span class="cmd__t"><span id="cmd-start-scan">loam scan</span> <span class="muted">  # im Projektordner</span></span>
            <button class="cmd__copy" type="button" data-testid="home-start-copy-scan" data-copy-target="cmd-start-scan" data-track="Scan" data-done="kopiert" data-failed="Kopieren fehlgeschlagen" aria-label="Scan-Befehl kopieren">kopieren</button>
          </div>
        </div>
        <div class="start__alt">
          <p class="cmd-note">Auf Apple-Silicon-Macs und Linux geht auch Homebrew, ganz ohne <code>PATH</code>-Anpassung:</p>
          <div class="cmd cmd--secondary">
            <span class="cmd__p" aria-hidden="true">$</span><span class="cmd__t" id="cmd-start-brew">brew install silvio-l/loam/loam</span>
            <button class="cmd__copy" type="button" data-testid="home-start-copy-brew" data-copy-target="cmd-start-brew" data-track="Install brew" data-done="kopiert" data-failed="Kopieren fehlgeschlagen" aria-label="Homebrew-Installationsbefehl kopieren">kopieren</button>
          </div>
          <p class="cmd-note">Findet deine Shell <code>loam</code> nach der pub-Installation nicht, ergänze <code>~/.pub-cache/bin</code> in deinem <code>PATH</code>.</p>
        </div>
        <p class="start__guide">
          <span class="muted">Im</span> <a class="link link--arrow" href="/de/developer-guide/" data-testid="home-start-guide">Developer Guide</a> <span class="muted">(auf Englisch) findest du jeden Befehl, das CI-Setup und die Konfiguration.</span>
        </p>
      </div>
    </div>
  </section>
