        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet zwei oder mehr Step 1:/Step 2:/First,/Next,/Then,/Finally,-Kommentare, die jeweils unmittelbar vor einem Statement im selben Funktions-/Methoden-/Konstruktor-Rumpf stehen und gemeinsam den Rumpf Schritt für Schritt erzählen, obwohl die Statements bereits selbsterklärend sind. Ein einzelner solcher Kommentar allein wird nicht gemeldet — nur eine Sequenz. Schweregrad: info. Generierte Dateien werden automatisch übersprungen."
        slopCode={`void placeOrder(Order order) {
  // Step 1: validate the order
  validate(order);
  // Step 2: charge the customer
  charge(order);
  // Finally, send the confirmation email
  sendConfirmation(order);
}`}
        cleanCode={`void placeOrder(Order order) {
  validate(order);
  charge(order);
  sendConfirmation(order);
}`}
      />

