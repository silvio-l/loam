---
import Layout from '../../layouts/Layout.astro';
import RuleCard from '../../components/RuleCard.astro';
import { t } from '../../i18n/ui';
import '../../styles/rules.css';

const lang = 'de';
const live = t(lang, 'rules.badge.live');
const planned = t(lang, 'rules.badge.planned');
const slopLabel = t(lang, 'rules.slop.label');
const cleanLabel = t(lang, 'rules.clean.label');
const profileLabels = {
  core: t(lang, 'rules.profile.core'),
  strict: t(lang, 'rules.profile.strict'),
};
---

<Layout
  lang="de"
  title="Rules — loam.dev"
  description="Alle Rules von loam.dev für Dart/Flutter: zwanzig heute aktiv, eine geplant. Was jede Rule findet, ob sie dein CI-Gate blockieren kann, und je ein gemeldetes und ein sauberes Codebeispiel."
  path="/de/rules"
>
  <span id="status" class="sr-only" role="status" aria-live="polite"></span>

  <header class="scene page-head rules-head" aria-labelledby="rules-title" data-testid="rules-head">
    <div class="wrap rules-head__grid intro">
      <p class="label">Rule-Verzeichnis</p>
      <h1 id="rules-title" class="display">Rules<span class="accent">.</span></h1>
      <p class="lead page-head__lead">Zwanzig Rules sind in loam.dev heute aktiv, eine weitere ist geplant. Jede Rule
      findet eine Art von Problem, zeigt ein gemeldetes und ein sauberes Beispiel und sagt
      dir, ob sie dein Gate blockieren kann. Alle stecken hinter einem stabilen <code>Rule</code>-Interface: Eine neue Rule erweitert die Liste, nie die Pipeline.</p>
      <div class="rules-head__profiles">
        <p class="label label--plain">Gate-Profile</p>
        <p class="body-copy-p">Jede aktive Rule hat ein Gate-Profil. <strong>core</strong>-Rules sind auf nahezu
      null Fehlalarme ausgelegt und standardmäßig die einzigen, die <code>loam gate</code> rot werden lassen. <strong>strict</strong>-Rules arbeiten mit Heuristiken oder
      Schwellenwerten: Sie laufen immer mit und erscheinen als Hinweis, blockieren aber nur
      mit <code>loam gate --profile strict</code> (oder <code>profile: strict</code> in der <code>loam.yaml</code>). Das Profil ändert <code>baseline.json</code> nie. Du bist mit
      einem einzelnen Finding nicht einverstanden? <code>// loam-ignore: &lt;rule-id&gt; – &lt;reason&gt;</code> schaltet es an Ort und
      Stelle stumm — die Begründung ist Pflicht.</p>
      </div>
    </div>
  </header>

  <div class="wrap rules-layout">
    <nav class="rules-index" aria-label="Rule-Verzeichnis" data-testid="rules-index">
      <p class="label label--plain rules-index__title">Rule-Verzeichnis</p>
      <p class="rules-index__group">Struktureller Drift</p>
      <ul>
        <li><a href="#unused-public-exports" data-testid="rules-index-unused-public-exports">unused-public-exports</a></li>
        <li><a href="#circular-dependencies" data-testid="rules-index-circular-dependencies">circular-dependencies</a></li>
        <li><a href="#architecture-boundaries" data-testid="rules-index-architecture-boundaries">architecture-boundaries</a></li>
        <li><a href="#code-duplicates" data-testid="rules-index-code-duplicates">code-duplicates</a></li>
        <li><a href="#complexity-hotspots" data-testid="rules-index-complexity-hotspots">complexity-hotspots</a></li>
      </ul>
      <p class="rules-index__group">Lücken in der Barrierefreiheit</p>
      <ul>
        <li><a href="#a11y-form-field-label" data-testid="rules-index-a11y-form-field-label">a11y-form-field-label</a></li>
        <li><a href="#a11y-image-label" data-testid="rules-index-a11y-image-label">a11y-image-label</a></li>
        <li><a href="#a11y-icon-button-label" data-testid="rules-index-a11y-icon-button-label">a11y-icon-button-label</a></li>
        <li><a href="#a11y-interactive-semantics" data-testid="rules-index-a11y-interactive-semantics">a11y-interactive-semantics</a></li>
      </ul>
      <p class="rules-index__group">AI-Slop</p>
      <ul>
        <li><a href="#hardcoded-secrets" data-testid="rules-index-hardcoded-secrets">hardcoded-secrets</a></li>
        <li><a href="#slop-empty-catch" data-testid="rules-index-slop-empty-catch">slop-empty-catch</a></li>
        <li><a href="#slop-unjustified-ignore" data-testid="rules-index-slop-unjustified-ignore">slop-unjustified-ignore</a></li>
        <li><a href="#slop-narrative-comment" data-testid="rules-index-slop-narrative-comment">slop-narrative-comment</a></li>
        <li><a href="#slop-workflow-narration-comment" data-testid="rules-index-slop-workflow-narration-comment">slop-workflow-narration-comment</a></li>
        <li><a href="#slop-placeholder-comment" data-testid="rules-index-slop-placeholder-comment">slop-placeholder-comment</a></li>
        <li><a href="#slop-unimplemented-stub" data-testid="rules-index-slop-unimplemented-stub">slop-unimplemented-stub</a></li>
        <li><a href="#slop-tautological-assertion" data-testid="rules-index-slop-tautological-assertion">slop-tautological-assertion</a></li>
        <li><a href="#slop-undisposed-resource" data-testid="rules-index-slop-undisposed-resource">slop-undisposed-resource</a></li>
        <li><a href="#slop-assertion-free-test" data-testid="rules-index-slop-assertion-free-test">slop-assertion-free-test</a></li>
        <li><a href="#slop-setstate-after-async-gap" data-testid="rules-index-slop-setstate-after-async-gap">slop-setstate-after-async-gap</a></li>
      </ul>
      <p class="rules-index__group">Geplant</p>
      <ul>
        <li><a href="#anti-ai-slop" data-testid="rules-index-anti-ai-slop">anti-ai-slop</a></li>
      </ul>
    </nav>

    <div class="rules-main">

    <!-- Live rules, grouped by kind of problem -->
    <section class="rules-section" aria-labelledby="live-title" data-testid="rules-live">
      <h2 id="live-title" class="sr-only">Live</h2>

      <h3 class="rules-group" id="group-structural"><span class="label label--plain">Struktureller Drift</span></h3>

      <RuleCard
        ruleId="unused-public-exports"
        title="Ungenutzte öffentliche Exports"
        status="live"
        badgeLabel={live}
        profile="core"
        profileLabel={profileLabels.core}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Findet öffentliche API-Member — Klassen, Methoden, Getter/Setter, Felder, Enums, Typedefs — ohne Referenz im gesamten Projekt. Die Analyse läuft auf dem aufgelösten Element-Model, nicht per Regex. Code-Generator-Eingaben (Drift, freezed, Riverpod, json_serializable) werden automatisch ausgeschlossen, ohne jede Konfiguration. Mit @visibleForTesting, @internal, @protected oder @pragma('loam:reserved') annotierte Symbole gelten als bewusst öffentlich und werden nicht gemeldet."
        slopCode={`// öffentlich, aber nirgendwo verwendet
class OldHelper {
  static String format(String s) => s.trim();
}

// ebenfalls unreferenziert — wird gemeldet
enum LegacyStatus { active, archived }`}
        cleanCode={`// entweder entfernen, privat machen oder
// mit Begründung unterdrücken:
// loam-ignore: unused-public-exports – re-exported via barrel

// genutzt und behalten:
class ActiveHelper {
  static String format(String s) => s.trim();
}`}
      />

      <RuleCard
        ruleId="circular-dependencies"
        title="Zirkuläre Dependencies"
        status="live"
        badgeLabel={live}
        profile="core"
        profileLabel={profileLabels.core}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Erkennt Import-Zyklen zwischen Dart-Bibliotheken. Zyklen machen die Kompilierungsreihenfolge mehrdeutig, verhindern Tree-Shaking und sind ein häufiges Zeichen unklarer Schichtverantwortlichkeiten."
        slopCode={`// lib/a.dart
import 'b.dart';

// lib/b.dart
import 'a.dart'; // ← Zyklus: a → b → a`}
        cleanCode={`// Gemeinsame Typen in eine dritte Bibliothek auslagern:
// lib/shared.dart  (importiert weder a noch b)
// lib/a.dart  importiert shared.dart
// lib/b.dart  importiert shared.dart`}
      />

      <RuleCard
        ruleId="architecture-boundaries"
        title="Architektur-Grenzen"
        status="live"
        badgeLabel={live}
        profile="core"
        profileLabel={profileLabels.core}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet Imports, die eine verbotene Layer-Grenze überschreiten. Layer und Grenzen stehen in der loam.yaml: loam init erkennt sie einmal und schreibt sie heraus, du verfeinerst sie, die Rule rät nie. Jedes Finding nennt den importierenden Layer, den Ziel-Layer und die Import-Zeile. Geprüft werden nur Imports, Exporte nicht. Ohne konfigurierte Grenzen keine Findings."
        slopCode={`// loam.yaml: boundaries: [{from: core, deny: [features]}]
// lib/core/theme.dart
import '../features/profile/profile_page.dart'; // ← core darf features nicht importieren`}
        cleanCode={`// core besitzt den Vertrag, features setzen ihn um:
// lib/core/page_factory.dart  (abstrakte Klasse, keine Feature-Imports)
// lib/features/profile/profile_page.dart
import '../../core/page_factory.dart';`}
      />

      <RuleCard
        ruleId="code-duplicates"
        title="Code-Duplikate"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="loam.dev findet Duplikate im Code per AST-normalisiertem Token-Hashing — exakte Kopien (Typ-1) und strukturell identische Blöcke mit umbenannten Bezeichnern oder Literalen (Typ-2). Jedes Finding beschreibt einen vollständigen Cluster mit allen Fundstellen, sodass die Baseline die gesamte Gruppe als einen Eintrag verfolgt. Ein klassischer KI-Agent-Nebeneffekt: Hilfsfunktionen, die kopiert statt extrahiert wurden. Gewollte Boilerplate (copyWith, ==, hashCode, toString, toJson, fromJson, …) wird übersprungen."
        slopCode={`// feature_a/utils.dart
String formatDate(DateTime d) =>
    '\${d.day}.\${d.month}.\${d.year}';

// feature_b/helpers.dart  ← Beinahe-Duplikat
String renderDate(DateTime d) =>
    '\${d.day}.\${d.month}.\${d.year}';`}
        cleanCode={`// lib/shared/date_format.dart
String formatDate(DateTime d) =>
    '\${d.day}.\${d.month}.\${d.year}';

// beide Features importieren den gemeinsamen Helper
// loam-ignore: code-duplicates – bewusste Symmetrie`}
      />

      <RuleCard
        ruleId="complexity-hotspots"
        title="Komplexitäts-Hotspots"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Misst zyklomatische und kognitive Komplexität je Funktion/Methode und aggregiert sie zu einem Projekt-Health-Score. Markiert Funktionen, die zu komplex zum Review oder Testen sind."
        slopCode={`// kognitive Komplexität ≫ Schwellwert
Future<void> syncData(List<Item> items) async {
  for (final item in items) {
    if (item.isValid) {
      if (item.needsSync) {
        try {
          if (await remote.has(item.id)) {
            await remote.update(item);
          } else { await remote.create(item); }
        } catch (e) { /* geschluckt */ }
      }
    }
  }
}`}
        cleanCode={`// aufgeteilt in fokussierte, testbare Helpers
Future<void> syncData(List<Item> items) async {
  final candidates = items.where(_needsSync);
  await Future.wait(candidates.map(_syncOne));
}

Future<void> _syncOne(Item item) async { … }`}
      />

      <h3 class="rules-group" id="group-a11y"><span class="label label--plain">Lücken in der Barrierefreiheit</span></h3>

      <RuleCard
        ruleId="a11y-form-field-label"
        title="Formularfeld ohne Label"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet Flutter-TextField- und TextFormField-Widgets, die weder ein decoration: InputDecoration(labelText: …) oder InputDecoration(label: Text(…)) (noch hintText als schwächerer Fallback) noch einen umschließenden Semantics(label: …)-Vorfahren haben. WCAG 1.3.1 (Info and Relationships), 3.3.2 (Labels or Instructions) und 4.1.2 (Name, Role, Value) verlangen, dass Formularfelder ein programmatisch bestimmbares Label haben. Die Analyse läuft auf dem aufgelösten Element-Model — lokale Klassen namens TextField werden nie gemeldet. Konservativ: ein decoration:-Wert, der keine direkte InputDecoration(…)-Erstellung ist, wird ignoriert. Rein AST-basiert: Laufzeitkontrast, Fokusreihenfolge, Touch-Target-Größen und dynamische Decoration-Werte sind außerhalb des Scope."
        slopCode={`// keine Decoration — Screen Reader hat kein Label
TextField()

// InputDecoration vorhanden, aber ohne labelText oder hintText
TextField(
  decoration: InputDecoration(),
)`}
        cleanCode={`// labelText liefert das primäre zugängliche Label
TextField(
  decoration: InputDecoration(labelText: 'E-Mail-Adresse'),
)

// hintText als Fallback (z. B. Suchfelder)
TextField(
  decoration: InputDecoration(hintText: 'Suchen…'),
)

// oder mit Semantics umschließen
Semantics(
  label: 'E-Mail-Adresse',
  child: TextField(),
)`}
      />

      <RuleCard
        ruleId="a11y-image-label"
        title="Bild ohne semantisches Label"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet Flutter-Image/Image.asset/Image.network/Image.file/Image.memory-Widgets ohne semanticLabel, die nicht per excludeFromSemantics: true, einen Semantics(excludeSemantics: true)- oder ExcludeSemantics-Vorfahren aus dem Accessibility-Tree ausgeschlossen und nicht von einem Semantics(label: …)-Vorfahren benannt sind. Bilder in Dot-Shorthand-Schreibweise werden mitgeprüft. WCAG 1.1.1 (Non-text Content) verlangt für jedes nicht-dekorative Bild eine Textalternative. Die Analyse läuft auf dem aufgelösten Element-Model — lokale Klassen namens Image werden nie gemeldet."
        slopCode={`// kein semantisches Label — Screen Reader liest nichts
Image.asset('assets/hero.png')

// explizit leeres Label wird ebenfalls gemeldet
Image.network('https://example.com/photo.jpg',
  semanticLabel: '',  // ← leer = fehlend`}
        cleanCode={`// beschreibt, was das Bild vermittelt
Image.asset('assets/hero.png',
  semanticLabel: 'App-Hero-Illustration')

// rein dekorativ: explizit ausschließen
Image.asset('assets/divider.png',
  excludeFromSemantics: true)`}
      />

      <RuleCard
        ruleId="a11y-icon-button-label"
        title="Icon-Button ohne zugänglichen Namen"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet Flutter-IconButton-Widgets ohne tooltip, ohne Icon mit semanticLabel und ohne umschließendes Semantics(label: …) oder Tooltip(message: …), sowie GestureDetector/InkWell-Widgets, deren direktes child ein reines Icon-Widget ist und denen ebenfalls ein Name dieser Art fehlt. WCAG 4.1.2 (Name, Role, Value) verlangt, dass jedes interaktive Steuerelement einen programmatisch bestimmbaren Namen hat. Die Analyse läuft auf dem aufgelösten Element-Model — lokale Klassen namens IconButton werden nie gemeldet. Rein AST-basiert: zusammengesetzte Icon-Kinder und dynamische tooltip-Werte sind außerhalb des Scope."
        slopCode={`// kein tooltip — Screen Reader gibt nichts aus
IconButton(
  icon: Icon(Icons.close),
  onPressed: () => Navigator.pop(context),
)

// GestureDetector mit bloßem Icon-Kind — gleiches Problem
GestureDetector(
  child: Icon(Icons.delete),
  onTap: () => deleteItem(),
)`}
        cleanCode={`// tooltip liefert den zugänglichen Namen
IconButton(
  icon: Icon(Icons.close),
  tooltip: 'Schließen',
  onPressed: () => Navigator.pop(context),
)

// oder mit Semantics für GestureDetector/InkWell wrappen
Semantics(
  label: 'Element löschen',
  child: GestureDetector(
    child: Icon(Icons.delete),
    onTap: () => deleteItem(),
  ),
)`}
      />

      <RuleCard
        ruleId="a11y-interactive-semantics"
        title="Interaktives Widget ohne Semantik"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet generische und benutzerdefinierte (nicht-Flutter-)Widgets, die einen onTap-, onPressed- oder onLongPress-Callback tragen, aber keinen umschließenden Semantics(label: …)-Vorfahren haben. WCAG 4.1.2 (Name, Role, Value) verlangt, dass jedes interaktive Steuerelement einen programmatisch bestimmbaren Namen hat. Die Analyse läuft auf dem aufgelösten Element-Model — Flutter-Built-in-Widgets, die bereits von Geschwister-Rules erfasst werden (IconButton, GestureDetector, InkWell, TextField, TextFormField), sind aus dieser Rule ausgeschlossen. Eigene Wrapper-Widgets werden gelesen statt geraten: leitet ihr build() einen Namen an Semantics(label:), einen Tooltip, ein label-/semanticLabel-/tooltip-Argument oder einen Text im Tipp-Bereich weiter — direkt oder über weitere Wrapper bis vier Ebenen tief —, gelten die Aufrufstellen als benannt. Ein Wrapper, der den Namen verschluckt, wird einmal an seiner Klasse gemeldet, egal wie oft er verwendet wird; ein Aufruf, der den Namen eines Wrappers weglässt, der einen annimmt, wird am Aufruf gemeldet. Nicht lesbare Wrapper (Drittanbieter, dynamisch) fallen auf die Prüfung des label-, semanticLabel- oder tooltip-Arguments an der Aufrufstelle zurück. Rein AST-basiert: außerhalb des Scope sind Widgets, die über vererbte Callbacks interaktiv werden, benutzerdefinierte Gesture-Recognizer, die die genannten Parameternamen umgehen, und Accessible-Name-Mechanismen außer Semantics(label: …)."
        slopCode={`// Custom-Karte ohne Semantics — Screen Reader hat keinen Namen
CustomCard(
  onTap: () => showDetails(item),
)

// Custom-Button mit onPressed — ebenfalls unbenannt
ActionChip(
  onPressed: () => doAction(),
)`}
        cleanCode={`// mit Semantics umschließen, um einen zugänglichen Namen zu geben
Semantics(
  label: 'Details anzeigen',
  button: true,
  child: CustomCard(
    onTap: () => showDetails(item),
  ),
)

// oder ein Widget wählen, das label nativ unterstützt
ActionChip(
  label: Text('Aktion ausführen'),
  onPressed: () => doAction(),
)`}
      />

      <h3 class="rules-group" id="group-slop"><span class="label label--plain">AI-Slop</span></h3>

      <RuleCard
        ruleId="hardcoded-secrets"
        title="Fest eingetragenes Geheimnis in einem String-Literal"
        status="live"
        badgeLabel={live}
        profile="core"
        profileLabel={profileLabels.core}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet API-Schlüssel, Passwörter und Tokens, die als String-Literale im Quellcode stehen — offline, ohne Token-Kosten, und der Wert erscheint nie im Report, in der Baseline oder im Fingerprint. Zwei Wege: bekannte Anbieter-Formate überall (AWS, GitHub, Stripe live, Slack, Anthropic/OpenAI, PEM-Private-Keys; Schweregrad error; Google-API-Keys sind eine Warnung mit Hinweis, den Key zu beschränken, da Google sie als Client-Kennungen behandelt) und Literale an Zugangsdaten-Namen (Variable, Argument, Parameter-Default, Zuweisung, Map-Schlüssel) mit hoher Entropie (Schweregrad warning). Platzhalter, Env-Variablen- und Storage-Key-Namen, String.fromEnvironment-/Platform.environment-Zugriffe, Tests, Fixtures, example/, generierte Dateien und firebase_options.dart werden nie gemeldet."
        slopCode={`// Zugangsdaten im Quellcode
const apiKey = 'k8Jx92LmQp4Zr7Tv0aBc';

final client = Client(password: 'Tr0ub4dor&3xQ');`}
        cleanCode={`// zur Build-Zeit injiziert: --dart-define=API_KEY=...
const apiKey = String.fromEnvironment('API_KEY');

// oder zur Laufzeit lesen
final password = Platform.environment['DB_PASSWORD'];`}
      />

      <RuleCard
        ruleId="slop-empty-catch"
        title="Leerer oder nur-Kommentar-catch-Block"
        status="live"
        badgeLabel={live}
        profile="core"
        profileLabel={profileLabels.core}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet catch-Blöcke, deren Rumpf leer ist ({}) oder nur Kommentare enthält — beide verschlucken Exceptions stillschweigend. Der offizielle empty_catches-Lint deckt das buchstäbliche {} bereits ab; loam ergänzt die Kommentar-only-Variante, die KI-Agenten häufig produzieren, wenn sie einen catch-Block mit einem Füll-Kommentar unterdrücken, sowie das projektweite Gate. catch (_) {} mit buchstäblich leerem Rumpf ist der bewusste Weg, einen Fehler zu ignorieren, und wird nicht gemeldet. Schweregrad: warning. Rümpfe mit einem rethrow, throw oder einem Logging-Aufruf werden nie gemeldet (konservative Allowlist). Generierte Dateien (.g.dart, .freezed.dart, …) werden automatisch übersprungen."
        slopCode={`// buchstäblich leer — Exception verschwindet
try {
  await fetchData();
} catch (e) {}

// nur Kommentar — gleiches Problem, von empty_catches übersehen
try {
  await fetchData();
} catch (e) {
  // TODO: behandeln
}`}
        cleanCode={`// loggen und weiterwerfen — Kontext bleibt erhalten
try {
  await fetchData();
} catch (e, st) {
  log('fetchData fehlgeschlagen', error: e, stackTrace: st);
  rethrow;
}

// oder in einen Domain-Error einwickeln
try {
  await fetchData();
} catch (e) {
  throw DataLoadException(cause: e);
}`}
      />

      <RuleCard
        ruleId="slop-unjustified-ignore"
        title="Unbegründete // ignore:-Direktive"
        status="live"
        badgeLabel={live}
        profile="core"
        profileLabel={profileLabels.core}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet // ignore:- und // ignore_for_file:-Direktiven ohne schriftliche Begründung — weder als Inline-Text nach den Lint-Namen noch als Kommentar in der vorherigen Zeile. Grundlose Unterdrückungsdirektiven sind ein häufiger KI-Agenten-Shortcut: der Agent bringt den Linter zum Schweigen, statt die eigentliche Ursache zu beheben. Schweregrad: info. Generierte Dateien (.g.dart, .freezed.dart, …) werden automatisch übersprungen."
        slopCode={`// kein Grund angegeben — warum wird dieser Lint unterdrückt?
// ignore: avoid_print
print('debug output');

// Datei-weite Unterdrückung ohne Begründung
// ignore_for_file: prefer_const_constructors`}
        cleanCode={`// Inline-Begründung: erklärt Reviewern, warum die Unterdrückung beabsichtigt ist
// ignore: avoid_print – CLI-Ausgabepfad, kein Debug-Statement
print('done.');

// Begründung in der Zeile darüber wird ebenfalls akzeptiert
// Unterdrückung: Diese Datei stammt aus vor Null-Safety und ist für die Migration vorgesehen.
// ignore_for_file: avoid_print`}
      />

      <RuleCard
        ruleId="slop-narrative-comment"
        title="Narrativer Füll-// Kommentar"
        status="live"
        badgeLabel={live}
        profile="strict"
        profileLabel={profileLabels.strict}
        slopLabel={slopLabel}
        cleanLabel={cleanLabel}
        description="Meldet // Kommentare, die keine Information über das hinaus liefern, was der Code bereits zeigt. Deklarationsnah: Text wiederholt den Namen (z. B. // build vor void build()) oder verwendet einen festen narrativen Ausdruck (constructor, getter, setter, build method, the <name> method/widget). Kontextfrei, überall in der Datei: dekorative Banner-/Trennkommentare, leere Kategorie-Label (Main logic, Helper function, …), reine Emoji-Dekoration, redundante Blockende-Marker (// end if) sowie vage TODOs ohne konkrete Handlung oder Referenz — ein TODO mit echter Substanz wird nie gemeldet. Schweregrad: info. Generierte Dateien werden automatisch übersprungen."
        slopCode={`// ==============================
// MyWidget
class MyWidget extends StatelessWidget {
  // Main logic
  // build
  @override
  Widget build(BuildContext context) => const SizedBox();

  // constructor
  const MyWidget();

  // TODO: fix later
}`}
        cleanCode={`class MyWidget extends StatelessWidget {
  // Rendert als Platzhalter mit der Größe 0 während der Ladephase.
  @override
  Widget build(BuildContext context) => const SizedBox();

  const MyWidget();

  // TODO: handle null case when userId is missing (see #123)
}`}
      />

      <RuleCard
