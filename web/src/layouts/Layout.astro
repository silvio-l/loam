---
/**
 * Layout.astro — Single Source of Chrome for loam.dev.
 *
 * Brand-Tokens (CSS :root): bg=#101014, ink=#ECEAE3, green=#88C840,
 *   soil=#564F47, dim=#8D8A7E — identisch zu assets/brand/tokens.json.
 *
 * Versions-Chip: v0.1.16 · preview (muss zur pubspec.yaml version passen).
 *
 * Footer-Link: Developer-Guide (On-Site-Route /developer-guide bzw. /de/developer-guide).
 *
 * Fonts (self-hosted via @fontsource, alle SIL OFL 1.1): Bricolage Grotesque
 * (Display + Fließtext, Akzente nur per Farbe/Gewicht — bewusst keine Serif),
 * Spline Sans Mono (Code, CLI-Ausgabe, Labels; Marken-Mono). KEIN Link zu fonts.googleapis.com / gstatic
 * (Privacy-Constraint). Designsystem: src/styles/site.css.
 */
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/spline-sans-mono/400.css';
import '@fontsource/spline-sans-mono/500.css';
import '@fontsource/spline-sans-mono/600.css';
import '../styles/site.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import WebVitals from '../components/WebVitals.astro';
import BrandMark from '../components/BrandMark.astro';
import GitHubStars from '../components/GitHubStars.astro';
import { githubStars } from '../lib/github-stars';
import { hreflangAlternates } from '../i18n/utils';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Canonical path, e.g. '/' or '/de/' or '/rules'. */
  path: string;
}

const { lang, title, description, path } = Astro.props;
const stars = await githubStars();
// Trailing-Slash-Form (Directory-Format): canonical, hreflang-Alternates und
// der LanguageSwitcher nutzen denselben normalisierten Pfad wie die Sitemap-
// <loc>-Einträge — so stimmen alle URL-Signale exakt überein.
const normalizedPath = path.endsWith('/') ? path : `${path}/`;
const alternates = hreflangAlternates(normalizedPath);
const canonicalUrl = `https://getloam.dev${normalizedPath}`;
const ogImage = 'https://getloam.dev/og-image.png';

// Structured Data (JSON-LD) — produkt-konstant, identisch auf jeder Route.
// SoftwareApplication macht loam für Google/Bing als Dev-Tool maschinenlesbar
// (Kategorie, OS, gratis); Organization bündelt sameAs (GitHub) + Logo.
// Bewusst KEIN aggregateRating, solange keine echten Reviews existieren.
// Die description folgt Tagline und Claims der Root-README (Anti-Vokabular-konform).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'loam.dev',
      url: 'https://getloam.dev/',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      description:
        'Codebase intelligence & anti-AI-slop for Dart & Flutter: finds structural drift, AI slop and accessibility gaps that dart analyze does not see, behind a baseline/ratchet CI gate that fails only on new findings.',
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
      author: { '@type': 'Organization', name: 'loam.dev', url: 'https://getloam.dev/' },
    },
    {
      '@type': 'Organization',
      name: 'loam.dev',
      url: 'https://getloam.dev/',
      logo: 'https://getloam.dev/loam-lockup.png',
      sameAs: ['https://github.com/silvio-l/loam'],
    },
  ],
};

// Hauptnavigation (locale-scharf). Labels aus i18n/ui.ts; die aktive Seite wird
// über den normalisierten Pfad markiert, damit jede Seite von jeder erreichbar ist.
const navBase = lang === 'de' ? '/de' : '';
const homeHref = lang === 'de' ? '/de/' : '/';
const navItems = [
  { id: 'how-it-works', href: `${navBase}/how-it-works/`, label: t(lang, 'nav.howItWorks') },
  { id: 'rules', href: `${navBase}/rules/`, label: t(lang, 'nav.rules') },
  { id: 'docs', href: `${navBase}/developer-guide/`, label: t(lang, 'nav.docs') },
];
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="theme-color" content="#101014">
  <link rel="canonical" href={canonicalUrl}>

  <!-- hreflang alternates (i18n SEO) -->
  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href}>
  ))}

  <!-- OpenGraph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="loam.dev">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="loam.dev — Codebase intelligence &amp; anti-AI-slop for Dart &amp; Flutter">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Structured Data (JSON-LD): SoftwareApplication + Organization -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Self-hosted fonts via @fontsource (Bricolage Grotesque,
       Spline Sans Mono; all SIL OFL 1.1) — no third-party font CDN requests.
       Font CSS is imported via ESM in the frontmatter so Vite bundles the woff2 files. -->
  <style is:inline>
    /* Brand-Tokens — identisch zu assets/brand/tokens.json (Corporate Design).
       88C840 = green | 564F47 = soil | ECEAE3 = ink | 101014 = bg
       Everything else in the design system (src/styles/site.css) derives from
       these tokens; no other hues are introduced.                           */
    :root{
      --bg:#101014; --ink:#ECEAE3; --green:#88C840; --soil:#564F47; --dim:#8D8A7E;
      --panel:#15171c; --panel-2:#1a1c22; --line:#23252b; --line-strong:#33363d;
      --green-a12:rgba(136,200,64,.12); --green-a40:rgba(136,200,64,.4);
      --green-a50:rgba(136,200,64,.5); --green-a70:rgba(136,200,64,.7);
      --soil-a30:rgba(86,79,71,.3); --soil-a55:rgba(86,79,71,.55);
      --flag:#E0785F; --flag-a14:rgba(224,120,95,.14);
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main" data-testid="layout-skip-link">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href={homeHref} aria-label="loam.dev" data-testid="layout-brand">
        <BrandMark class="brand__mark" />
        <img class="wm-sm" src="/wordmark.svg" alt="loam.dev" width="480" height="120">
      </a>
      <nav class="mainnav" data-testid="layout-main-nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
        {navItems.map(item => (
          <a
            href={item.href}
            data-testid={`layout-nav-${item.id}`}
            class:list={["navlink", { active: normalizedPath === item.href }]}
            aria-current={normalizedPath === item.href ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
      <div class="header-right">
        <!-- Versions-Chip: v0.1.16 · preview — muss zur pubspec.yaml version passen -->
        <span class="chip">v0.1.16 · preview</span>
        <LanguageSwitcher lang={lang} path={normalizedPath} />
        <GitHubStars initialCount={stars} ariaLabel={t(lang, 'stars.ariaLabel')} />
        <a class="btn btn--primary btn--sm header-cta" href={`${homeHref}#install`} data-testid="layout-nav-install">{t(lang, 'nav.install')}</a>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <!-- Matomo Analytics — prod-only, cookiefrei, DSGVO-konfiguriert.
       Site-ID 3 = loam (getloam.dev). Deaktiviert im Dev-Server via import.meta.env.PROD. -->
  {/* WARNUNG: NIEMALS _paq.push(["setAnonymizeIp", ...]) ergänzen — keine gültige Matomo-5-
      JS-Methode, wirft TypeError und bricht die _paq-Queue ab (trackPageView läuft nie ->
      Tracking-Totalausfall, Juni 2026). IP-Anonymisierung passiert serverseitig in Matomo.
      Jede Snippet-Änderung -> CSP-Hash in public/_headers neu (csp-build.test.ts erzwingt es). */}
  {import.meta.env.PROD && (
    <script is:inline set:html={`var _paq = (window._paq = window._paq || []);
_paq.push(["disableCookies"]);
_paq.push(["enableHeartBeatTimer"]);
_paq.push(["trackPageView"]);
_paq.push(["enableLinkTracking"]);
(function () {
  _paq.push(["setTrackerUrl", "https://matomo.silvio-und-maik.de/matomo.php"]);
  _paq.push(["setSiteId", "3"]);
  var d = document, g = d.createElement("script");
  g.src = "https://matomo.silvio-und-maik.de/matomo.js";
  g.async = true;
  d.head.appendChild(g);
})();`} />
  )}

  <!-- Core Web Vitals (RUM) → Matomo custom events. First-party bundled, prod-only. -->
  {import.meta.env.PROD && <WebVitals enabled={true} />}

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <div class="site-footer__brand">
        <BrandMark class="site-footer__mark" />
        <img class="site-footer__wm" src="/wordmark.svg" alt="loam.dev" width="480" height="120" loading="lazy">
        <p class="site-footer__tag">{t(lang, 'footer.tagline')}</p>
      </div>
      <nav class="site-footer__links" aria-label={t(lang, 'footer.navLabel')}>
        <a href={`${navBase}/how-it-works/`} data-testid="layout-footer-how">{t(lang, 'nav.howItWorks')}</a>
        <a href={`${navBase}/rules/`} data-testid="layout-footer-rules">{t(lang, 'nav.rules')}</a>
        <a href={lang === 'de' ? '/de/developer-guide/' : '/developer-guide/'} data-testid="layout-footer-guide">{t(lang, 'footer.devGuide')}</a>
        <a href={lang === 'de' ? '/de/privacy/' : '/privacy/'} data-testid="layout-footer-privacy">{t(lang, 'footer.privacy')}</a>
        <a href="https://github.com/silvio-l/loam" target="_blank" rel="noopener" data-testid="layout-footer-github">GitHub<span class="ext" aria-hidden="true">↗</span><span class="sr-only"> {t(lang, 'a11y.newTab')}</span></a>
        <a href="https://silvio-lindstedt.de" target="_blank" rel="noopener me" data-testid="layout-footer-author">{t(lang, 'footer.author')}<span class="ext" aria-hidden="true">↗</span><span class="sr-only"> {t(lang, 'a11y.newTab')}</span></a>
      </nav>
      <p class="site-footer__legal">{t(lang, 'footer.copyright')}</p>
    </div>
  </footer>
  <!-- Site behaviour (copy buttons, share, scene progress fallback): one bundled
       first-party module from 'self' — no inline JS, so no CSP hash needed. -->
  <script>import '../scripts/site.ts';</script>
</body>
</html>
